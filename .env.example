# ---------------------------------------------------------------------------
# Atithi Platform — environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# In AWS, all secrets live in Secrets Manager / SSM — not in Lambda env vars.
# ---------------------------------------------------------------------------

# --- Deployment ---
AWS_REGION=ap-south-1
STAGE=dev
# Custom domain (optional). Leave blank to use the CloudFront default domain.
WEB_DOMAIN=
API_DOMAIN=
ACM_CERTIFICATE_ARN=

# --- DynamoDB (populated by CDK at deploy time) ---
TABLE_NAME=atithi-main-dev

# --- Cognito (populated by CDK at deploy time) ---
USER_POOL_ID=
USER_POOL_CLIENT_ID=

# --- Media bucket ---
MEDIA_BUCKET=

# ---------------------------------------------------------------------------
# AI provider
# Used ONLY for: natural-language search parsing, grounded property Q&A,
# and translation. The model is never allowed to invent prices, availability
# or property facts — see backend/src/ai/groundedAssistant.ts
# ---------------------------------------------------------------------------
# One of: bedrock | openai | anthropic
AI_PROVIDER=bedrock

# For AI_PROVIDER=bedrock (recommended on AWS — no API key, uses IAM)
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_REGION=ap-south-1

# For AI_PROVIDER=openai
# Store in Secrets Manager as: atithi/<stage>/ai-api-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# For AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Secrets Manager secret id holding the AI key (preferred over env var)
AI_API_KEY_SECRET_ID=atithi/dev/ai-api-key

# Hard cap so a runaway prompt cannot drain the budget
AI_MAX_OUTPUT_TOKENS=800
AI_MONTHLY_BUDGET_INR=5000

# --- Payments (Razorpay — India) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET_ID=atithi/dev/razorpay-secret
RAZORPAY_WEBHOOK_SECRET_ID=atithi/dev/razorpay-webhook

# --- Messaging ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN_SECRET_ID=atithi/dev/whatsapp-token
SMS_SENDER_ID=ATITHI

# --- Telephony (AI receptionist — see docs/10) ---
TELEPHONY_PROVIDER=exotel
TELEPHONY_WEBHOOK_SECRET_ID=atithi/dev/telephony-webhook

# --- Frontend (Vite — only VITE_* vars are exposed to the browser) ---
VITE_API_BASE_URL=http://localhost:3000
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_AWS_REGION=ap-south-1
VITE_DEFAULT_LOCALE=en
